#!/bin/bash
#SBATCH --job-name=po4ig_sw
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --time=01:15:00
#SBATCH --output=outputs/slurm-%j.out
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak9088@princeton.edu

# Usage: sbatch slurm/po4ncpa_infogain_sweep.slurm <LAMBDA>
# Decisive control: isolate the info-gain term's effect at IDENTICAL config. LAMBDA=0 is
# the pure-control baseline (max_steps=8, warmup=1000, parallel) -- if it descends like
# plain M2 but LAMBDA>0 does not, the info-gain auxiliary is purely harmful.
LAMBDA=${1:?pass lambda_info as arg1}

module purge
module load anaconda3/2025.6
conda activate /scratch/network/ak9088/anaconda3/envs/dmrl2
cd /scratch/network/ak9088/NASA-RL-Wavefront-Control/RL
export PYTHONPATH=/scratch/network/ak9088/NASA-RL-Wavefront-Control/RL/src:$PYTHONPATH

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NUMEXPR_MAX_THREADS=1
set -eo pipefail

python src/po4ncpa_infogain.py \
    --run-name po4ncpa_infogain_l${LAMBDA} \
    --use-coronagraph true \
    --num-modes 55 --aberration-start-mode 4 --q 3 --num-airy 5.5 \
    --dark-hole-iwa 1.5 --dark-hole-owa 4.0 \
    --rms-min 0.026 --rms-max 0.026 \
    --aberration-spectrum power_law --psd-exponent 3.667 \
    --per-mode-scale true --action-headroom 5.0 --probe-frac 0.1 \
    --num-workers 14 --max-steps 8 --lambda-info ${LAMBDA} \
    --total-episodes 4000 --warmup-episodes 1000 \
    --eval-every 250 --eval-episodes 20 \
    --ensemble 5 --ch 64 --dyn-iters 8 --pol-iters 5 --batch 64 \
    --dyn-lr 1e-3 --pol-lr 1e-4 --explore-std 0.1 \
    --seed 0

echo "=== PO4NCPA INFOGAIN SWEEP lambda=${LAMBDA} DONE ==="
